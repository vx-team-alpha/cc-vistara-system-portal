{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": {
      "version": "19.3.1"
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "jsx_a11y/prefer-tag-over-role": "off",
    "jsx_a11y/no-noninteractive-element-interactions": "off",
    "eslint/no-unsafe-finally": "warn",
    "eslint/no-unused-vars": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "cc-/**",
    "supabase/**",
    "src/types/supabase.ts",
    "src/components/portal/configurator.jsx"
  ]
}
