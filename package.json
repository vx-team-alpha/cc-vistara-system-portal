{
  "name": "cc-frontage-desgn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "supabase:template": "scripts/supabase-vm/template.sh",
    "supabase:template-refresh": "scripts/supabase-vm/template.sh --force",
    "supabase:template-destroy": "scripts/supabase-vm/template-destroy.sh",
    "supabase:start": "scripts/supabase-vm/start.sh",
    "supabase:stop": "scripts/supabase-vm/stop.sh",
    "supabase:destroy": "scripts/supabase-vm/destroy.sh",
    "supabase:reset": "scripts/supabase-vm/exec.sh db reset",
    "supabase:diff": "scripts/supabase-vm/exec.sh db diff --use-pg-delta -f",
    "supabase:typegen": "scripts/supabase-vm/exec.sh gen types typescript --local > src/types/supabase.ts",
    "worktree:add": "scripts/supabase-vm/worktree-add.sh",
    "worktree:remove": "scripts/supabase-vm/worktree-remove.sh",
    "catalogue:prepare": "node scripts/catalogue/seed.mjs prepare",
    "catalogue:upload": "node scripts/catalogue/seed.mjs upload",
    "catalogue:seed": "node scripts/catalogue/seed.mjs seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@hugeicons/core-free-icons": "^4.4.0",
