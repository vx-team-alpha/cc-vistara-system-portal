{
  "name": "cc-frontage-desgn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:oxlint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "supabase:template": "scripts/supabase-vm/template.sh",
    "supabase:template-refresh": "scripts/supabase-vm/template.sh --force",
    "supabase:template-destroy": "scripts/supabase-vm/template-destroy.sh",
    "supabase:start": "scripts/supabase-vm/start.sh",
    "supabase:stop": "scripts/supabase-vm/stop.sh",
    "supabase:destroy": "scripts/supabase-vm/destroy.sh",
    "supabase:reset": "scripts/supabase-vm/exec.sh db reset",
    "supabase:diff": "scripts/supabase-vm/exec.sh db diff --use-pg-delta -f",
    "supabase:typegen": "scripts/supabase-vm/exec.sh gen types typescript | sed -n '/^export type Json/,$p' | sed '/^} as const/q' > src/types/supabase.ts",
    "worktree:add": "scripts/supabase-vm/worktree-add.sh",
    "worktree:remove": "scripts/supabase-vm/worktree-remove.sh",
    "worktree:delete": "scripts/supabase-vm/worktree-remove.sh",
    "worktree:list": "scripts/supabase-vm/worktree-list.sh",
    "worktree:prune": "git worktree prune -v",
    "catalogue:prepare": "node scripts/catalogue/seed.mjs prepare",
    "catalogue:upload": "node scripts/catalogue/seed.mjs upload",
    "catalogue:seed": "node scripts/catalogue/seed.mjs seed",
    "seed:users": "node scripts/seed-users.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.66.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.jsx": [
      "oxfmt"
    ],
    "*.{css,json,jsonc,md,mdx,yml,yaml,html}": [
      "oxfmt"
    ]
  }
}
