{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "clsx", "cva"],
    "preserveWhitespace": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "package-lock.json",
    "next-env.d.ts",
    "supabase/**",
    "src/types/supabase.ts"
  ]
}
